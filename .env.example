# Lokal ist diese Variable optional; ohne sie verwendet die App SQLite.
# Auf Vercel wird sie von der Neon-Integration bereitgestellt.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Kostenloser API Read Access Token aus den TMDB-Kontoeinstellungen (bevorzugt).
TMDB_API_TOKEN=dein_tmdb_api_read_access_token

# Alternativ werden auch diese gebräuchlichen Namen unterstützt:
# TMDB_API_READ_TOKEN=dein_tmdb_api_read_access_token
# TMDB_API_KEY=dein_32_stelliger_v3_api_schluessel
